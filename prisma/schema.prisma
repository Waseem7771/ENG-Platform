generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ==================== AUTH & USERS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("STUDENT") // STUDENT | TEACHER
  level         String?   // BEGINNER | INTERMEDIATE | ADVANCED
  locale        String    @default("ar") // ar | en — UI language
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth relations
  sessions      AuthSession[]
  accounts      Account[]

  // Teacher relations
  teacherClasses  Class[]          @relation("TeacherClasses")
  teacherSessions LiveSession[]    @relation("TeacherSessions")
  createdLessons  Lesson[]         @relation("CreatedLessons")
  createdExercises Exercise[]      @relation("CreatedExercises")

  // Student relations
  classEnrollments ClassStudent[]
  exerciseResults  ExerciseResult[]
  placementExams   PlacementExam[]
  progress         Progress[]
  sessionMessages  SessionMessage[]
  sessionStudents  SessionStudent[]
}

// ==================== BETTER AUTH TABLES ====================

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ==================== CLASSES ====================

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  level       String   // BEGINNER | INTERMEDIATE | ADVANCED
  code        String   @unique // Join code for students
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher  User           @relation("TeacherClasses", fields: [teacherId], references: [id])
  students ClassStudent[]
  sessions LiveSession[]
  lessons  Lesson[]
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

// ==================== SESSIONS (Live) ====================

model LiveSession {
  id        String    @id @default(cuid())
  classId   String
  teacherId String
  title     String
  status    String    @default("WAITING") // WAITING | ACTIVE | ENDED
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher  User             @relation("TeacherSessions", fields: [teacherId], references: [id])
  messages SessionMessage[]
  students SessionStudent[]
}

model SessionStudent {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  content   String
  type      String   @default("TEXT") // TEXT | SYSTEM | EXERCISE
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

// ==================== LESSONS & EXERCISES ====================

model Lesson {
  id          String   @id @default(cuid())
  classId     String
  createdById String
  title       String
  description String?
  content     String?  // Rich text content
  order       Int      @default(0)
  level       String   // BEGINNER | INTERMEDIATE | ADVANCED
  unit        Int      @default(1) // Unit number (1-6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User       @relation("CreatedLessons", fields: [createdById], references: [id])
  exercises Exercise[]
}

model Exercise {
  id          String   @id @default(cuid())
  lessonId    String?
  createdById String
  title       String
  type        String   // GRAMMAR | VOCABULARY | TRANSLATION | LISTENING | QUIZ | PUZZLE | CONVERSATION | PICTURE | STORY
  difficulty  String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  data        String   // JSON string containing exercise content
  timeLimit   Int?     // Time limit in seconds (for timed exercises)
  points      Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson    Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy User             @relation("CreatedExercises", fields: [createdById], references: [id])
  results   ExerciseResult[]
}

model ExerciseResult {
  id          String   @id @default(cuid())
  exerciseId  String
  studentId   String
  score       Int      // 0-100
  timeSpent   Int?     // Time spent in seconds
  answers     String?  // JSON string of student answers
  completedAt DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ==================== PLACEMENT EXAM ====================

model PlacementExam {
  id          String   @id @default(cuid())
  studentId   String
  score       Int      // Overall score 0-100
  level       String   // Determined level: BEGINNER | INTERMEDIATE | ADVANCED
  answers     String   // JSON string of exam answers
  breakdown   String?  // JSON string: { grammar: 80, vocabulary: 70, reading: 90 }
  completedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ==================== PROGRESS TRACKING ====================

model Progress {
  id        String   @id @default(cuid())
  studentId String
  category  String   // GRAMMAR | VOCABULARY | TRANSLATION | LISTENING | SPEAKING | OVERALL
  score     Int      @default(0) // Current score in this category
  streak    Int      @default(0) // Daily streak
  xp        Int      @default(0) // Experience points
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, category])
}
