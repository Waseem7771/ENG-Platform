# ===== SpeakPath environment =====
# Local dev: copy to .env
# VPS production: copy to .env.production next to docker-compose.yml

# Database
#   local dev:        file:./dev.db
#   docker (VPS):     file:/app/data/speakpath.db   (persisted in the app_data volume)
DATABASE_URL="file:./dev.db"

# OpenAI — powers AI conversations, translation scoring, and feedback.
# Without a real key the platform still works with basic (non-AI) scoring.
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Better Auth
#   Generate a secret:  openssl rand -base64 32
#   BETTER_AUTH_URL must be the public URL of the site (https://yourdomain.com in prod)
BETTER_AUTH_SECRET="change-me-generate-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SpeakPath"

# Caddy site address (docker only):
#   your domain (e.g. speakpath.example.com) => automatic HTTPS via Let's Encrypt
#   or ":80" to serve plain HTTP on the VPS IP while you don't have a domain
SITE_ADDRESS=":80"
